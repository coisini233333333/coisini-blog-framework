---
import { render } from 'astro:content';
import type { BlogPost } from '../../lib/posts';
import { getPosts, formatDate, readingTime } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import { siteConfig } from '../../config/site';
export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props {
  post: BlogPost;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const isEssay = post.data.category === 'essay';
const categoryPath = isEssay ? '/essays/' : '/technology/';
const categoryLabel = isEssay ? '随笔' : '技术笔记';
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  section={isEssay ? 'essays' : 'technology'}
>
  <div class="article-top">
    <a class="text-link" href={withBase(categoryPath)}>
      ← {categoryLabel}
    </a>
  </div>
  <header class="article-heading">
    <div class="article-tags">
      {post.data.tags.map((tag) => (
        <span>{tag}</span>
      ))}
      {post.data.sample && <span class="sample-label">示例文章</span>}
    </div>
    <h1>{post.data.title}</h1>
    <p>{post.data.description}</p>
    <div class="article-meta">
      <span>{siteConfig.author}</span>
      <span>·</span>
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span>·</span>
      <span>约 {readingTime(post.body || '')} 分钟</span>
    </div>
    {post.data.updatedDate && (
      <p class="updated-date">更新于 {formatDate(post.data.updatedDate)}</p>
    )}
  </header>
  {post.data.cover && (
    <img
      class="article-cover"
      src={withBase(post.data.cover)}
      alt={post.data.coverAlt}
      width="1200"
      height="600"
    />
  )}
  <div class="article-layout">
    <article class="prose">
      <Content />
    </article>
    {toc.length > 0 && (
      <aside class="article-toc">
        <nav aria-label="文章目录">
          <p>目录</p>
          <ol>
            {toc.map((heading) => (
              <li class:list={{ 'toc-sub': heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    )}
  </div>
  <div class="article-end">
    <a class="text-link" href={withBase(categoryPath)}>
      返回{categoryLabel} →
    </a>
  </div>
</BaseLayout>
