---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import { withBase } from '../lib/paths';
import { getPosts } from '../lib/posts';
import { projects } from '../data/projects';
const technicalPosts = (await getPosts()).filter((post) => post.data.category === 'technical');
---

<BaseLayout section="home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">
        {siteConfig.heroTitle[0]}
        <br />
        <em>{siteConfig.heroTitle[1]}</em>
      </h1>
      <p class="hero-description">{siteConfig.description}</p>
      <div class="hero-actions">
        <a class="button primary" href={withBase('/projects/')}>
          查看项目 <Icon name="arrow" size={18} />
        </a>
        <a class="text-link" href={withBase('/technology/')}>
          技术笔记 <Icon name="arrow" size={16} />
        </a>
      </div>
      <a class="essay-entry" href={withBase('/essays/')}>
        <span>随笔</span>
        <Icon name="arrow" size={17} />
      </a>
    </div>
    <figure class="hero-visual">
      <div class="image-mat">
        <img
          src={withBase(siteConfig.heroImage)}
          alt={siteConfig.heroImageAlt}
          width="960"
          height="1080"
          fetchpriority="high"
        />
      </div>
    </figure>
  </section>
  <section class="latest-section" aria-labelledby="projects-title">
    <div class="section-heading">
      <h2 id="projects-title">项目</h2>
      <a class="text-link" href={withBase('/projects/')}>
        全部项目 <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
  <section class="latest-section technology-section" aria-labelledby="technology-title">
    <div class="section-heading">
      <h2 id="technology-title">技术</h2>
      <a class="text-link" href={withBase('/technology/')}>
        全部笔记 <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="post-grid two-column">
      {technicalPosts.slice(0, 2).map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
