---
import { withBase } from '../lib/paths';
interface Props {
  kind?: string;
}
const { kind = 'landscape' } = Astro.props;
---

{kind === 'particles' ? (
  <svg
    class="post-art"
    viewBox="0 0 640 400"
    aria-hidden="true"
    focusable="false"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect width="640" height="400" fill="#e5ebdd" />
    <circle cx="497" cy="74" r="128" fill="#d8e1cd" />
    <circle cx="95" cy="350" r="134" fill="#edf0e3" />
    <g fill="#91a58b">
      <circle cx="114" cy="111" r="7" />
      <circle cx="189" cy="91" r="9" />
      <circle cx="146" cy="176" r="10" />
      <circle cx="228" cy="144" r="6" />
      <circle cx="90" cy="227" r="8" />
      <circle cx="204" cy="239" r="11" />
      <circle cx="139" cy="295" r="7" />
      <circle cx="239" cy="295" r="6" />
    </g>
    <path
      d="M271 200h77m-15-14 15 14-15 14"
      fill="none"
      stroke="#6d846c"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path d="M399 125c38-27 102-3 114 41s-13 114-64 121-72-40-68-86 7-68 18-76Z" fill="#c5d4bc" />
    <g fill="#45684e">
      <circle cx="423" cy="155" r="9" />
      <circle cx="465" cy="152" r="7" />
      <circle cx="410" cy="194" r="8" />
      <circle cx="450" cy="190" r="11" />
      <circle cx="482" cy="210" r="8" />
      <circle cx="435" cy="234" r="9" />
      <circle cx="467" cy="263" r="6" />
      <circle cx="402" cy="255" r="6" />
    </g>
  </svg>
) : kind === 'interface' ? (
  <svg
    class="post-art"
    viewBox="0 0 640 400"
    aria-hidden="true"
    focusable="false"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect width="640" height="400" fill="#ebe7d9" />
    <ellipse cx="326" cy="329" rx="153" ry="15" fill="#d7d7c6" />
    <circle cx="217" cy="167" r="104" fill="#d6dfcb" />
    <rect x="260" y="63" width="146" height="270" rx="22" fill="#3c5a48" />
    <rect x="270" y="75" width="126" height="244" rx="15" fill="#f8f8ef" />
    <path d="M316 87h34" stroke="#b2bca5" stroke-width="4" stroke-linecap="round" />
    <rect x="284" y="111" width="98" height="59" rx="8" fill="#d6e0c9" />
    <path d="m289 163 27-29 22 17 13-13 27 25" fill="#94ae88" />
    <circle cx="363" cy="125" r="8" fill="#ece2b6" />
    <path d="M286 187h76m-76 13h51" stroke="#c2cbb7" stroke-width="4" stroke-linecap="round" />
    <rect x="283" y="223" width="100" height="34" rx="6" fill="#638361" />
    <path
      d="m338 288-4-56 43 34-23 2-9 21Z"
      fill="#e3cba0"
      stroke="#587250"
      stroke-width="2.5"
      stroke-linejoin="round"
    />
    <path
      d="M433 132c39 11 48 50 33 80m-3-18 3 20 17-10M220 280c-35-6-53-40-44-68m-12 15 12-17 9 18"
      fill="none"
      stroke="#9ba98e"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
) : (
  <img
    class="post-art"
    src={withBase('/images/landscape.svg')}
    alt=""
    width="960"
    height="1080"
    loading="lazy"
  />
)}

<style>
  .post-art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
