---
interface Props {
  name: 'arrow' | 'sun' | 'moon' | 'github' | 'rss' | 'search' | 'leaf';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'arrow' && (
    <>
      <path d="M5 12h14M13 6l6 6-6 6" />
    </>
  )}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
    </>
  )}
  {name === 'moon' && <path d="M20.5 14.1A8.8 8.8 0 0 1 9.9 3.5a8.8 8.8 0 1 0 10.6 10.6Z" />}
  {name === 'github' && (
    <>
      <path d="M9 19c-4 1-4-2-6-2m12 5v-3.9c0-1.1-.4-1.8-.8-2.2 2.8-.3 5.8-1.4 5.8-6.3 0-1.4-.5-2.5-1.3-3.4.1-.4.6-1.7-.1-3.4 0 0-1.1-.4-3.6 1.3a12.5 12.5 0 0 0-6 0C6.5 2.4 5.4 2.8 5.4 2.8c-.7 1.7-.2 3-.1 3.4C4.5 7.1 4 8.2 4 9.6c0 4.9 3 6 5.8 6.3-.4.4-.8 1.2-.8 2.2V22" />
    </>
  )}
  {name === 'rss' && (
    <>
      <circle cx="5" cy="19" r="1" />
      <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
    </>
  )}
  {name === 'search' && (
    <>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="m16 16 5 5" />
    </>
  )}
  {name === 'leaf' && (
    <>
      <path d="M20 4C9 2 3 8 6 16c8 3 14-1 14-12Z" />
      <path d="m4 21 11-12" />
    </>
  )}
</svg>
