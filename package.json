{
  "name": "coisini-blog-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "test:build": "node scripts/verify-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "astro": "astro",
    "content:init": "node scripts/init-content.mjs",
    "test:privacy": "node scripts/verify-privacy.mjs",
    "deploy": "node scripts/publish.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3"
  },
  "description": "A reusable Astro blog with private content bundles and static publishing",
  "license": "MIT"
}
